# Copiar este archivo a ".env" y completar los valores.
# El archivo ".env" real NO se sube al repositorio.

# Contraseña del usuario "consultorio" de PostgreSQL (solo letras y números)
POSTGRES_PASSWORD=cambiar_esta_contrasena

# Clave con la que n8n cifra las credenciales guardadas.
# Generar con: head -c 24 /dev/urandom | base64 | tr -dc 'A-Za-z0-9'
N8N_ENCRYPTION_KEY=generar_una_clave_aleatoria
